// in handleMessageWhenUp() and the socket-callback socketDataArrived().
class Pm3App : public ApplicationBase, public INetworkSocket::ICallback {
  protected:
    // ── Event-B machine state ──
    std::map<PktId, Node> pktFwdr;
    std::map<PktId, Data> pktData;
    std::set<PktId> createdPkts;
