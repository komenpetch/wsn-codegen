  {
    "content": "// Generated by wsn-codegen from the Event-B refinement chain pM1 → uM2 → pM3 (merged into one module).
// Do not edit by hand — regenerate instead.
#include "Pm3App.h"

#include "inet/common/ModuleAccess.h"
#include "inet/common/Protocol.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/lifecycle/ModuleOperations.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/networklayer/common/L3AddressResolver.h"
#include "inet/networklayer/common/L3AddressTag_m.h"
#include "inet/networklayer/contract/L3Socket.h"
#include "inet/networklayer/contract/ipv4/Ipv4Socket.h"
#include "inet/networklayer/contract/ipv6/Ipv6Socket.h"

namespace eb_pm3app {
Define_Module(Pm3App);

simsignal_t Pm3App::packetSentSignal = registerSignal("packetSent");
simsignal_t Pm3App::packetReceivedSignal = registerSignal("packetReceived");

// Event-B INITIALISATION.
Pm3App::Pm3App() {
    pktFwdr.clear();
    pktData.clear();
    createdPkts.clear();
    ndBuff.clear();
    sentUp.clear();
    sentDown.clear();
    ctlNeighbours.clear();
    destBuff.clear();
    recvBuff.clear();
    clrRecvBuffFlg.clear();
    for (int _n : ND) if (Dests.count(_n) == 0) ctlSensedFlg[_n] = FALSE;
    for (int _n : ND) if (Dests.count(_n) == 0) senseBuff[_n] = {};
}

Pm3App::~Pm3App() {
    cancelAndDelete(timer);
    delete socket;
}

void Pm3App::initialize(int stage) {
    ApplicationBase::initialize(stage);
    if (stage == INITSTAGE_LOCAL) {
        sensingIntervalPar = &par("sensingInterval");
        payloadLength = par("payloadLength");
        startTime = par("startTime");
        stopTime = par("stopTime");
        if (stopTime >= SIMTIME_ZERO && stopTime < startTime)
            throw cRuntimeError("Invalid startTime/stopTime parameters");

        sendSeqNo = sentCount = receivedCount = 0;
        WATCH(sendSeqNo);
        WATCH(sentCount);
        WATCH(receivedCount);
        timer = new cMessage("sensingTimer");
    }
}

bool Pm3App::isEnabled() {
    // the module emits packets only when a destination is configured
    return par("sinkAddress").stringValue()[0] != '\\0';
}

void Pm3App::openSocket() {
    // Resolve the sink lazily (it may stay empty on a passive sink-side node).
    const char *sinkStr = par("sinkAddress");
    if (sinkStr[0])
        sinkAddress = L3AddressResolver().resolve(sinkStr);

    // Determine the network-layer protocol below us. An explicit parameter
    // wins; otherwise infer it from the resolved address type, so a node with
    // a destination but no configured protocol still opens a socket.
    const Protocol *networkProtocol = nullptr;
    const char *netProtoStr = par("networkProtocol");
    if (*netProtoStr) {
        networkProtocol = Protocol::getProtocol(netProtoStr);
    }
    else if (!sinkAddress.isUnspecified()) {
        switch (sinkAddress.getType()) {
            case L3Address::IPv4: networkProtocol = &Protocol::ipv4; break;
            case L3Address::IPv6: networkProtocol = &Protocol::ipv6; break;
            case L3Address::MODULEID:
            case L3Address::MODULEPATH: networkProtocol = &Protocol::nextHopForwarding; break;
            default:
                throw cRuntimeError("Pm3App: cannot infer networkProtocol from address type %d",
                                    (int)sinkAddress.getType());
        }
    }
    else {
        // no destination and no explicit protocol: nothing to open
        EV_INFO << "Pm3App: passive mode without a networkProtocol parameter; not opening socket\\n";
        return;
    }

    // Create the matching socket type; L3Socket carries an arbitrary payload.
    if (networkProtocol == &Protocol::ipv4)
        socket = new Ipv4Socket(gate("socketOut"));
    else if (networkProtocol == &Protocol::ipv6)
        socket = new Ipv6Socket(gate("socketOut"));
    else
        socket = new L3Socket(networkProtocol, gate("socketOut"));
    socket->bind(&Protocol::manet, L3Address());
    socket->setCallback(this);
}

// Send-down flow: build one packet and hand it down to the network layer
// through the socket (same as SensorApp). Driven by the sensing timer.
// The model's bool sendSensorPacket(Node, PktId) below (Event-B: send_down)
// carries the same transmit structure under its guard chain; it stays unwired
// until the network-layer phase binds the model identities.
void Pm3App::sendSensorPacket() {
    if (sinkAddress.isUnspecified() || socket == nullptr) {
        EV_WARN << "Pm3App: sinkAddress unspecified, skipping send\\n";
        return;
    }

    char name[32];
    snprintf(name, sizeof(name), "sensor-%ld", sendSeqNo);

    Packet *packet = new Packet(name);
    auto payload = makeShared<ByteCountChunk>(B(payloadLength));
    packet->insertAtBack(payload);

    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::manet);
    auto addrReq = packet->addTag<L3AddressReq>();
    addrReq->setDestAddress(sinkAddress);

    EV_INFO << "Pm3App: sending sample #" << sendSeqNo
            << " (" << payloadLength << "B) to " << sinkAddress << endl;

    emit(packetSentSignal, packet);
    socket->send(packet);

    sendSeqNo++;
    sentCount++;
}

void Pm3App::scheduleNextSensing(simtime_t previous) {
    simtime_t next;
    if (previous < SIMTIME_ZERO)
        next = simTime() <= startTime ? startTime : simTime();
    else
        next = previous + *sensingIntervalPar;
    if (stopTime < SIMTIME_ZERO || next < stopTime)
        scheduleAt(next, timer);
}

void Pm3App::cancelNextSensing() {
    cancelEvent(timer);
}

void Pm3App::handleMessageWhenUp(cMessage *msg) {
    if (msg->isSelfMessage()) {
        ASSERT(msg == timer);
        sendSensorPacket();
        // EXTENSION POINT (send-down flow): to drive the transmission from the
        // model instead, bind the identities and call start_tx(x, pkt) then
        // sendSensorPacket(x, pkt) (Event-B: send_down) here — that path also
        // needs the context populated (see the header).
        scheduleNextSensing(simTime());
    }
    else if (socket && socket->belongsToSocket(msg)) {
        socket->processMessage(msg);   // delivered to socketDataArrived
    }
    else {
        EV_WARN << "Pm3App: dropping unaccepted message " << msg->getName()
                << " (" << msg->getClassName() << ")\\n";
        delete msg;
    }
}

// Send-up flow: a packet the network layer sent up arrives here via
// handleMessageWhenUp → socket (same as SensorApp).
void Pm3App::socketDataArrived(INetworkSocket *, Packet *packet) {
    // EXTENSION POINT (send-up flow): to let the model consume the delivery,
    // bind the identities and call socketDataArrived(x, pkt, nbrs) (Event-B:
    // send_up) here. That overload keeps its own receivedCount++, so wiring it
    // in means dropping the one below or the receive count doubles.

    EV_INFO << "Pm3App: received " << packet->getByteLength()
            << "B from " << packet->getTag<L3AddressInd>()->getSrcAddress() << endl;
    receivedCount++;
    emit(packetReceivedSignal, packet);
    delete packet;
}

void Pm3App::socketClosed(INetworkSocket *) {}

void Pm3App::handleStartOperation(LifecycleOperation *) {
    openSocket();
    if (isEnabled() && !sinkAddress.isUnspecified())
        scheduleNextSensing(-1);
}

void Pm3App::handleStopOperation(LifecycleOperation *) {
    cancelNextSensing();
    if (socket && socket->isOpen())
        socket->close();
    delayActiveOperationFinish(par("stopOperationTimeout"));
}

void Pm3App::handleCrashOperation(LifecycleOperation *operation) {
    cancelNextSensing();
    if (socket && operation->getRootModule() != getContainingNode(this))
        socket->destroy();
}

void Pm3App::refreshDisplay() const {
    ApplicationBase::refreshDisplay();
    char buf[48];
    snprintf(buf, sizeof(buf), "sent: %ld\\nrcvd: %ld", sentCount, receivedCount);
    getDisplayString().setTagArg("t", 0, buf);
}

void Pm3App::finish() {
    recordScalar("packets sent", sentCount);
    recordScalar("packets received", receivedCount);
}

bool Pm3App::sensing(Node x, bool sf, Data data) {
    if (!((ND.count(x) > 0 && Dests.count(x) == 0)))
        return false;
    if (!(ctlSensedFlg.count(x) > 0))
        return false;
    if (!(ctlSensedFlg.at(x) == FALSE))
        return false;
    ctlSensedFlg[x] = sf;
    senseBuff[x].insert(data);
    return true;
}

bool Pm3App::creatingDataPacket(Node x, int des, PktId pkt, Data data) {
    if (!((ND.count(x) > 0 && Dests.count(x) == 0)))
        return false;
    if (!(x == initialSrcAddr.at(pkt)))
        return false;
    if (!(des == finalDestAddr.at(pkt)))
        return false;
    if (!(pktFwdr.count(pkt) == 0))
        return false;
    if (!(pktData.count(pkt) == 0))
        return false;
    if (!(ndBuff.count({x, pkt}) == 0))
        return false;
    if (!(type.at(pkt) == DATA))
        return false;
    if (!(!senseBuff.empty()))
        return false;
    if (!((senseBuff.count(x) > 0 && senseBuff.at(x).count(data) > 0)))
        return false;
    createdPkts.insert(pkt);
    pktFwdr[pkt] = x;
    pktData[pkt] = data;
    ndBuff.insert({x, pkt});
    senseBuff[x].erase(data); if (senseBuff[x].empty()) senseBuff.erase(x);
    return true;
}

bool Pm3App::creatingControlPacket(Node x, int des, PktId pkt, Data data) {
    if (!((ND.count(x) > 0 && Dests.count(x) == 0)))
        return false;
    if (!(x == initialSrcAddr.at(pkt)))
        return false;
    if (!(des == finalDestAddr.at(pkt)))
        return false;
    if (!(pktFwdr.count(pkt) == 0))
        return false;
    if (!(pktData.count(pkt) == 0))
        return false;
    if (!(ndBuff.count({x, pkt}) == 0))
        return false;
    if (!(data == CTL_VAL))
        return false;
    if (!(CONTROL.count(type.at(pkt)) > 0))
        return false;
    createdPkts.insert(pkt);
    pktFwdr[pkt] = x;
    pktData[pkt] = data;
    ndBuff.insert({x, pkt});
    return true;
}

bool Pm3App::start_tx(Node x, PktId pkt) {
    if (!(sentDown.count({x, pkt}) == 0))
        return false;
    if (!(sentUp.count({x, pkt}) == 0))
        return false;
    if (!(pktFwdr.count(pkt) > 0))
        return false;
    if (!(ndBuff.count({x, pkt}) > 0))
        return false;
    sentDown.insert({x, pkt});
    pktFwdr[pkt] = x;
    ndBuff.erase({x, pkt});
    return true;
}

// Event-B: send_down — emitted under its SensorApp name (thesis S4, transmit).
bool Pm3App::sendSensorPacket(Node x, PktId pkt) {
    if (!(sentDown.count({x, pkt}) > 0))
        return false;
    // — SensorApp transmit structure (SensorApp::sendSensorPacket) —
    if (socket == nullptr || sinkAddress.isUnspecified()) {
        EV_WARN << "socket/sinkAddress not ready, skipping send\\n";
        return false;
    }
    char pktName[32];
    snprintf(pktName, sizeof(pktName), "sensor-%ld", sendSeqNo);
    Packet *packet = new Packet(pktName);
    auto payload = makeShared<ByteCountChunk>(B(payloadLength));
    packet->insertAtBack(payload);
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::manet);
    packet->addTag<L3AddressReq>()->setDestAddress(sinkAddress);
    emit(packetSentSignal, packet);
    socket->send(packet);
    sendSeqNo++;
    sentCount++;
    return true;
}

// Event-B: send_up — emitted under its SensorApp name (thesis S5, receive).
bool Pm3App::socketDataArrived(Node x, PktId pkt, const std::set<Node>& nbrs) {
    if (!(sentUp.count({x, pkt}) == 0))
        return false;
    if (!(sentDown.count({x, pkt}) > 0))
        return false;
    if (!(ctlNeighbours.count(pkt) == 0))
        return false;
    if (!(!nbrs.empty()))
        return false;
    // — SensorApp receive structure (accounting; the packet object itself
    //   is handled in socketDataArrived, which calls this event) —
    receivedCount++;
    for (auto _v : nbrs) ctlNeighbours[pkt].insert(_v);
    sentDown.erase({x, pkt});
    sentUp.insert({x, pkt});
    return true;
}

bool Pm3App::receive(Node nb, PktId pkt) {
    if (!(recvBuff.count({nb, pkt}) == 0))
        return false;
    if (!(sentUp.count({nb, pkt}) == 0))
        return false;
    if (!(sentDown.count({nb, pkt}) == 0))
        return false;
    recvBuff.insert({nb, pkt});
    ctlNeighbours[pkt].erase(nb); if (ctlNeighbours[pkt].empty()) ctlNeighbours.erase(pkt);
    return true;
}

bool Pm3App::clear_recvdBuff(Node nb, PktId pkt) {
    if (!(recvBuff.count({nb, pkt}) > 0))
        return false;
    if (!(clrRecvBuffFlg.count({nb, pkt}) > 0))
        return false;
    recvBuff.erase({nb, pkt});
    return true;
}

bool Pm3App::fwdr_receive_pkt(Node nb, PktId pkt) {
    if (!(recvBuff.count({nb, pkt}) > 0))
        return false;
    if (!(clrRecvBuffFlg.count({nb, pkt}) == 0))
        return false;
    if (!(Dests.count(nb) == 0))
        return false;
    if (!(ndBuff.count({nb, pkt}) == 0))
        return false;
    clrRecvBuffFlg.insert({nb, pkt});
    ndBuff.insert({nb, pkt});
    return true;
}

bool Pm3App::dest_recv_pkt(Node nb, PktId pkt) {
    if (!(recvBuff.count({nb, pkt}) > 0))
        return false;
    if (!(clrRecvBuffFlg.count({nb, pkt}) == 0))
        return false;
    if (!(destBuff.count({nb, pkt}) == 0))
        return false;
    destBuff.insert({nb, pkt});
    clrRecvBuffFlg.insert({nb, pkt});
    return true;
}

bool Pm3App::finish_tx_pkt(Node x, PktId pkt) {
    if (!((ctlNeighbours.count(pkt) == 0 || ctlNeighbours.at(pkt).empty())))
        return false;
    if (!(inRan(sentUp, pkt)))
        return false;
    if (!(!inRan(sentDown, pkt)))
        return false;
    if (!(inDom(sentUp, x)))
        return false;
    if (!(sentUp.count({x, pkt}) > 0))
        return false;
    if (!(inRan(ndBuff, pkt)))
        return false;
    sentUp.erase({x, pkt});
    return true;
}

bool Pm3App::final_tx_pkt(PktId pkt) {
    if (!((ctlNeighbours.count(pkt) == 0 || ctlNeighbours.at(pkt).empty())))
        return false;
    if (!(inRan(sentUp, pkt)))
        return false;
    if (!(!inRan(sentDown, pkt)))
        return false;
    if (!(!inRan(ndBuff, pkt)))
        return false;
    for (auto it = sentUp.begin(); it != sentUp.end(); ) it->second == pkt ? it = sentUp.erase(it) : ++it;
    return true;
}

}  // namespace eb_pm3app
