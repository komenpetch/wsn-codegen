{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node", "vitest/globals", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting — the same bar src/ is held to. Before the netlayer merge these
       files were checked by netlayer/tsconfig.json, which had noUnusedLocals
       OFF; three dead symbols had accumulated behind it. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts"],
  /* scripts/_*.ts are local diagnostic probes (gitignored, never published). */
  "exclude": ["scripts/_*.ts"]
}
