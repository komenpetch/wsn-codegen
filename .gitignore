/out/
/out-*/

# Local diagnostic probes (never published).
scripts/_*.ts

# Local benchmark output (scripts/benchmark.ts, scripts/measure-*). Regenerable,
# and not the paper's measurement data — that lives frozen in paper2/data/.
runs.ndjson
runs-pre-trules.ndjson

# This machine's agent configuration, not part of the tool.
.claude/
