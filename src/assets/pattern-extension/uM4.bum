<?xml version="1.0" encoding="UTF-8"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
   <org.eventb.core.seesContext name="sees1" org.eventb.core.target="C2_ctl"/>
   <org.eventb.core.refinesMachine name="ref1" org.eventb.core.target="pM3"/>
   <org.eventb.core.variable name="var0" org.eventb.core.identifier="pktFwdr"/>
   <org.eventb.core.variable name="var1" org.eventb.core.identifier="pktData"/>
   <org.eventb.core.variable name="var2" org.eventb.core.identifier="createdPkts"/>
   <org.eventb.core.variable name="var3" org.eventb.core.identifier="ndBuff"/>
   <org.eventb.core.variable name="var4" org.eventb.core.identifier="sentDown"/>
   <org.eventb.core.variable name="var5" org.eventb.core.identifier="sentUp"/>
   <org.eventb.core.variable name="var6" org.eventb.core.identifier="ctlNeighbours"/>
   <org.eventb.core.variable name="var7" org.eventb.core.identifier="destBuff"/>
   <org.eventb.core.variable name="var8" org.eventb.core.identifier="recvBuff"/>
   <org.eventb.core.variable name="var9" org.eventb.core.identifier="clrRecvBuffFlg"/>
   <org.eventb.core.variable name="var10" org.eventb.core.identifier="ctlSensedFlg"/>
   <org.eventb.core.variable name="var11" org.eventb.core.identifier="senseBuff"/>
   <org.eventb.core.variable name="var12" org.eventb.core.identifier="emergencyAlert"/>
   <org.eventb.core.variable name="var13" org.eventb.core.identifier="pktSeqNo"/>
   <org.eventb.core.invariant name="inv01" org.eventb.core.label="MPacket_pktSeqNo_inv_1" org.eventb.core.predicate="pktSeqNo ∈ PKT ⇸ ℕ" org.eventb.core.comment="per-packet sequence number: serves duplicate detection and the missed count, both communication concerns" org.eventb.core.theorem="false"/>
   <org.eventb.core.event name="evt_init" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="INITIALISATION">
      <org.eventb.core.action name="act01" org.eventb.core.label="MPacket_pktSeqNo_int_1" org.eventb.core.assignment="pktSeqNo ≔ ∅"/>
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_sensing" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="sensing">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_activate" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="activate">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e0" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="creatingDataPacket">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e1" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="start_tx">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e2" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="send_down">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e3" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="send_up">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e4" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="receive">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e5" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="clear_recvdBuff">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e6" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="fwdr_receive_pkt">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e7" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="dest_recv_pkt">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e8" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="finish_tx_pkt">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_e9" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="final_tx_pkt">
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_route" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="create_routePkt" org.eventb.core.comment="Tier A. Splits the abstract creatingControlPacket per packet subtype: guards 1-6 and actions 1-4 are the abstract event verbatim, g7 strengthens type(pkt) : CONTROL to = ROUTE, and g8/a5 carry the new sequence number.">
      <org.eventb.core.refinesEvent name="ref1" org.eventb.core.target="creatingControlPacket"/>
      <org.eventb.core.parameter name="prm01" org.eventb.core.identifier="x"/>
      <org.eventb.core.parameter name="prm02" org.eventb.core.identifier="des"/>
      <org.eventb.core.parameter name="prm03" org.eventb.core.identifier="pkt"/>
      <org.eventb.core.parameter name="prm04" org.eventb.core.identifier="data"/>
      <org.eventb.core.parameter name="prm05" org.eventb.core.identifier="sno"/>
      <org.eventb.core.guard name="grd01" org.eventb.core.label="MPacket_creating_pkt_g1" org.eventb.core.predicate="x ∈ ND ∖ Dests ∧ pkt ∈ PKT ∧ data ∈ ℤ" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd02" org.eventb.core.label="MPacket_creating_pkt_g2" org.eventb.core.predicate="x = initialSrcAddr(pkt) ∧ des = ran({pkt} ◁ finalDestAddr)" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd03" org.eventb.core.label="MPacket_creating_pkt_g3" org.eventb.core.predicate="pkt ∉ dom(pktFwdr)" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd04" org.eventb.core.label="MPacket_creating_pkt_g4" org.eventb.core.predicate="pkt ∉ dom(pktData)" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd05" org.eventb.core.label="MNDbuffMgt_record_ndBuff_g1" org.eventb.core.predicate="x ↦ pkt ∉ ndBuff" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd06" org.eventb.core.label="User_defined_guard_g1" org.eventb.core.predicate="data = CTL_VAL" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd07" org.eventb.core.label="User_defined_guard_g2" org.eventb.core.predicate="type(pkt) = ROUTE" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd08" org.eventb.core.label="MPacket_pktSeqNo_g1" org.eventb.core.predicate="pkt ∉ dom(pktSeqNo) ∧ sno ∈ ℕ" org.eventb.core.theorem="false"/>
      <org.eventb.core.action name="act01" org.eventb.core.label="MPacket_creating_pkt_a1" org.eventb.core.assignment="createdPkts ≔ createdPkts ∪ {pkt}"/>
      <org.eventb.core.action name="act02" org.eventb.core.label="MPacket_creating_pkt_a2" org.eventb.core.assignment="pktFwdr ≔ pktFwdr ∪ {pkt ↦ x}"/>
      <org.eventb.core.action name="act03" org.eventb.core.label="MPacket_creating_pkt_a3" org.eventb.core.assignment="pktData ≔ pktData ∪ {pkt ↦ data}"/>
      <org.eventb.core.action name="act04" org.eventb.core.label="MNDbuffMgt_record_ndBuff_a1" org.eventb.core.assignment="ndBuff ≔ ndBuff ∪ {x ↦ pkt}"/>
      <org.eventb.core.action name="act05" org.eventb.core.label="MPacket_pktSeqNo_a1" org.eventb.core.assignment="pktSeqNo ≔ pktSeqNo ∪ {pkt ↦ sno}"/>
   </org.eventb.core.event>
   <org.eventb.core.event name="evt_bcon" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="create_bconPkt" org.eventb.core.comment="Tier A. Identical to create_routePkt except g7. B1: the originator guard stays the pattern's x : ND \ Dests -- beacon DIRECTION is how nodes reach each other, so MintRoute's sink-originated beacon is expressed by its Specific class, not here.">
      <org.eventb.core.refinesEvent name="ref1" org.eventb.core.target="creatingControlPacket"/>
      <org.eventb.core.parameter name="prm01" org.eventb.core.identifier="x"/>
      <org.eventb.core.parameter name="prm02" org.eventb.core.identifier="des"/>
      <org.eventb.core.parameter name="prm03" org.eventb.core.identifier="pkt"/>
      <org.eventb.core.parameter name="prm04" org.eventb.core.identifier="data"/>
      <org.eventb.core.parameter name="prm05" org.eventb.core.identifier="sno"/>
      <org.eventb.core.guard name="grd01" org.eventb.core.label="MPacket_creating_pkt_g1" org.eventb.core.predicate="x ∈ ND ∖ Dests ∧ pkt ∈ PKT ∧ data ∈ ℤ" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd02" org.eventb.core.label="MPacket_creating_pkt_g2" org.eventb.core.predicate="x = initialSrcAddr(pkt) ∧ des = ran({pkt} ◁ finalDestAddr)" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd03" org.eventb.core.label="MPacket_creating_pkt_g3" org.eventb.core.predicate="pkt ∉ dom(pktFwdr)" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd04" org.eventb.core.label="MPacket_creating_pkt_g4" org.eventb.core.predicate="pkt ∉ dom(pktData)" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd05" org.eventb.core.label="MNDbuffMgt_record_ndBuff_g1" org.eventb.core.predicate="x ↦ pkt ∉ ndBuff" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd06" org.eventb.core.label="User_defined_guard_g1" org.eventb.core.predicate="data = CTL_VAL" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd07" org.eventb.core.label="User_defined_guard_g2" org.eventb.core.predicate="type(pkt) = BEACON" org.eventb.core.theorem="false"/>
      <org.eventb.core.guard name="grd08" org.eventb.core.label="MPacket_pktSeqNo_g1" org.eventb.core.predicate="pkt ∉ dom(pktSeqNo) ∧ sno ∈ ℕ" org.eventb.core.theorem="false"/>
      <org.eventb.core.action name="act01" org.eventb.core.label="MPacket_creating_pkt_a1" org.eventb.core.assignment="createdPkts ≔ createdPkts ∪ {pkt}"/>
      <org.eventb.core.action name="act02" org.eventb.core.label="MPacket_creating_pkt_a2" org.eventb.core.assignment="pktFwdr ≔ pktFwdr ∪ {pkt ↦ x}"/>
      <org.eventb.core.action name="act03" org.eventb.core.label="MPacket_creating_pkt_a3" org.eventb.core.assignment="pktData ≔ pktData ∪ {pkt ↦ data}"/>
      <org.eventb.core.action name="act04" org.eventb.core.label="MNDbuffMgt_record_ndBuff_a1" org.eventb.core.assignment="ndBuff ≔ ndBuff ∪ {x ↦ pkt}"/>
      <org.eventb.core.action name="act05" org.eventb.core.label="MPacket_pktSeqNo_a1" org.eventb.core.assignment="pktSeqNo ≔ pktSeqNo ∪ {pkt ↦ sno}"/>
   </org.eventb.core.event>
</org.eventb.core.machineFile>
